// ============================================================
// OpenClaw 网关 + Agent 配置
// 格式：JSON5（支持注释和尾逗号）
//
// ${VAR} 占位符由 openclaw 在启动时从容器环境变量解析。
// 修改模型：编辑 .env.production 中的 OPENCLAW_MODEL
// 修改 API Key：编辑 .env.production 中的对应字段
// ============================================================
{
  // ── 网关配置 ────────────────────────────────────────────────
  gateway: {
    // Docker bridge 模式必须使用 "lan"（监听所有网卡），
    // 否则默认 loopback 只监听 127.0.0.1，容器外无法访问
    bind: "lan",
    port: 18789,
    auth: {
      mode: "token",
      // 从环境变量读取，由 deploy.sh 自动生成并写入 .env.production
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },

  // ── Agent 定义 ──────────────────────────────────────────────
  agents: {
    defaults: {
      // 默认工作目录（容器内路径）
      workspace: "/home/node/.openclaw/workspace",
    },
    list: [
      {
        // id 必须与 backend 请求头 x-openclaw-agent-id 对应
        id: "HR_Juzi",
        default: true,
        name: "HR 橘子",
        identity: {
          emoji: "🍊",
          theme: "你是一名专业的 HR 招聘助手，擅长在 BOSS 直聘平台上高效完成候选人筛选和沟通工作。",
        },
        // 模型格式：provider/model-name
        // 支持 anthropic/claude-* | openai/gpt-* | openrouter/* 等
        // 由 .env.production 中 OPENCLAW_MODEL 决定
        model: "${OPENCLAW_MODEL}",
        workspace: "/home/node/.openclaw/workspace",
      },
    ],
  },
}
