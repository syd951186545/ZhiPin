# ============================================================
# 机灵平台 · 唯一手动配置文件
# 用法：cp .env.example .env.production，填入真实值后执行 ./deploy.sh
# 说明：deploy.sh prepare/build/all 会把这里定义的值作为唯一事实源，生成 frontend/.env.production、
#       backend/.env.production 与镜像内的 openclaw.json。该文件中的生产配置和密钥会被写入镜像。
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# 前端构建时注入（VITE_前缀），后端运行时读取（无前缀）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=
# 登录态 storageState 的 AES-256-GCM 密钥；留空则 deploy.sh prepare/build/all 自动生成并回填
SESSION_ENCRYPTION_KEY=

# ── OpenClaw 网关（构建进 backopenclaw 镜像） ───────────────
# AUTH TOKEN：留空则 deploy.sh prepare/build/all 自动生成并回填
OPENCLAW_AUTH_TOKEN=
OPENCLAW_GATEWAY_TOOLS_ALLOW=gateway
OPENCLAW_RESPONSES_API_ENABLED=true
# OpenClaw host browser 状态服务；验证/解绑会固定走 target="host"
OPENCLAW_BROWSER_BASE_URL=http://127.0.0.1:18791

# ── OpenClaw Agent 配置 ─────────────────────────────────────
OPENCLAW_AGENT_ID=HR_Juzi
OPENCLAW_AGENT_NAME=HR 橘子
OPENCLAW_AGENT_EMOJI=🍊
OPENCLAW_AGENT_THEME=你是一名专业的 HR 招聘助手，擅长在网页版本的招聘平台上高效完成公告发布、候选人筛选和沟通工作。

# ── OpenClaw 模型配置 ────────────────────────────────────────
# 修改此处即可切换 LLM 提供商；也可在部署后通过前端"设置→AI→服务器配置"页面修改
OPENCLAW_MODEL_API_KEY=your-llm-api-key
OPENCLAW_MODEL_PROVIDER=minimax-cn
OPENCLAW_MODEL_API_BASE_URL=https://api.minimaxi.com/anthropic
OPENCLAW_MODEL_API_TYPE=anthropic-messages
OPENCLAW_MODEL_ID=MiniMax-M2.5
OPENCLAW_MODEL_NAME=MiniMax M2.5
OPENCLAW_MODEL_ALIAS=Minimax
OPENCLAW_MODEL_REASONING=true
OPENCLAW_MODEL_INPUT_TYPES=text
OPENCLAW_MODEL_COST_INPUT=0.3
OPENCLAW_MODEL_COST_OUTPUT=1.2
OPENCLAW_MODEL_COST_CACHE_READ=0.03
OPENCLAW_MODEL_COST_CACHE_WRITE=0.12
OPENCLAW_MODEL_CONTEXT_WINDOW=200000
OPENCLAW_MODEL_MAX_TOKENS=8192

# ── 后端服务器 ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# ── Docker 镜像配置 ─────────────────────────────────────────
# 如需境内镜像加速，可额外在 .env.production 自行声明覆盖：
# OPENCLAW_APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
# OPENCLAW_NPM_REGISTRY=https://registry.npmmirror.com
# OPENCLAW_PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
FRONTEND_IMAGE_REPO=zhipin/frontend
BACKOPENCLAW_IMAGE_REPO=zhipin/backopenclaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_PLAYWRIGHT_SKILL_REF=v4.1.0

# ── Docker Compose 运行参数 ─────────────────────────────────
EXPOSE_PORT=80
OPENCLAW_TZ=Asia/Shanghai
