# ============================================================
# 智聘云 · 唯一手动配置文件
# 用法：cp .env.example .env.production，填入真实值后执行 ./deploy.sh
# 说明：01_prepare_env.sh 会把这里定义的值作为唯一事实源，生成 frontend/backend/openclaw 配置。
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# 前端构建时注入（VITE_前缀），后端运行时读取（无前缀）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=

# ── OpenClaw 网关 ───────────────────────────────────────────
# AUTH TOKEN：留空则 01_prepare_env.sh / deploy.sh 自动生成并回填
OPENCLAW_AUTH_TOKEN=
OPENCLAW_BASE_URL=http://localhost:28789
OPENCLAW_MEDIA_MOUNT=/openclaw-home/.openclaw/media

# ── OpenClaw Agent 配置 ─────────────────────────────────────
OPENCLAW_AGENT_ID=HR_Juzi
OPENCLAW_AGENT_NAME=HR 橘子
OPENCLAW_AGENT_EMOJI=🍊
OPENCLAW_AGENT_THEME=你是一名专业的 HR 招聘助手，擅长在网页版本的招聘平台上高效完成公告发布、候选人筛选和沟通工作。

# ── OpenClaw 模型配置 ────────────────────────────────────────
# 修改此处即可切换 LLM 提供商；也可在部署后通过前端"设置→AI→服务器配置"页面修改
OPENCLAW_MODEL_API_KEY=your-llm-api-key
OPENCLAW_MODEL_PROVIDER=minimax-cn
OPENCLAW_MODEL_API_BASE_URL=https://api.minimaxi.com/anthropic
OPENCLAW_MODEL_API_TYPE=anthropic-messages
OPENCLAW_MODEL_ID=MiniMax-M2.5
OPENCLAW_MODEL_NAME=MiniMax M2.5
OPENCLAW_MODEL_ALIAS=Minimax
OPENCLAW_MODEL_REASONING=true
OPENCLAW_MODEL_INPUT_TYPES=text
OPENCLAW_MODEL_COST_INPUT=0.3
OPENCLAW_MODEL_COST_OUTPUT=1.2
OPENCLAW_MODEL_COST_CACHE_READ=0.03
OPENCLAW_MODEL_COST_CACHE_WRITE=0.12
OPENCLAW_MODEL_CONTEXT_WINDOW=200000
OPENCLAW_MODEL_MAX_TOKENS=8192

# ── 后端服务器 ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# ── Docker 镜像配置 ─────────────────────────────────────────
FRONTEND_IMAGE_REPO=zhipin/frontend
BACKEND_IMAGE_REPO=zhipin/backend
OPENCLAW_RUNTIME_REPO=zhipin/openclaw
# OpenClaw 官方源镜像，建议固定版本而非 latest
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# 预装到 openclaw 镜像内的社区 Playwright Browser Skill 版本
OPENCLAW_PLAYWRIGHT_SKILL_REF=v4.1.0

# ── Docker Compose 运行参数 ─────────────────────────────────
EXPOSE_PORT=80
OPENCLAW_TZ=Asia/Shanghai
# 宿主机暴露端口；若已被占用可改为未占用端口（如 28789）
OPENCLAW_HOST_PORT=28789
OPENCLAW_HOST_PORT_BROWSER=28791
