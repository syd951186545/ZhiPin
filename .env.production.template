# ============================================================
# 智聘云 生产环境配置模板
# 使用方法: cp .env.production.template .env.production
# 然后填入真实值
# ============================================================

# ── Frontend (build-time, Vite 构建时注入) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend (runtime, FastAPI 运行时读取) ───────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# 可选: service_role 密钥，用于后端绕过 RLS 上传截图到 Storage
SUPABASE_SERVICE_KEY=

# OpenClaw (Docker 内部通过服务名通信，无需修改)
# 如果 OpenClaw 不在 Docker 内运行，改为宿主机 IP
OPENCLAW_BASE_URL=http://openclaw:18789
OPENCLAW_AUTH_TOKEN=your-openclaw-auth-token
OPENCLAW_AGENT_ID=HR_Juzi

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Docker 共享卷 (与 docker-compose.yml 中的 volume mount 对应)
OPENCLAW_MEDIA_MOUNT=/openclaw-media

# CORS (nginx 同源访问，"*" 即可)
CORS_ORIGINS=*

# ── Docker Compose 变量 ────────────────────────────────────

# 前端暴露端口 (默认 80)
EXPOSE_PORT=80

# OpenClaw Docker 镜像 (替换为实际镜像名)
OPENCLAW_IMAGE=openclaw/openclaw:latest
