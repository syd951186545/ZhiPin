# ============================================================
# 智聘云 生产环境配置模板
# 使用方法: cp .env.production.template .env.production
# 然后填入真实值
# ============================================================

# ── Frontend (build-time, Vite 构建时注入) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend (runtime, FastAPI 运行时读取) ───────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# 可选: service_role 密钥，用于后端绕过 RLS 上传截图到 Storage
SUPABASE_SERVICE_KEY=

# OpenClaw (Docker 内部通过服务名通信，无需修改)
# 如果 OpenClaw 不在 Docker 内运行，改为宿主机 IP
OPENCLAW_BASE_URL=http://openclaw:18789
# Auth Token：留空则 deploy.sh 自动生成并回填此处，无需手动填写
OPENCLAW_AUTH_TOKEN=
OPENCLAW_AGENT_ID=HR_Juzi

# ── OpenClaw LLM 配置 ──────────────────────────────────────
# 模型格式：provider/model-name（在 docker/openclaw.json 中被引用）
# 支持 anthropic/claude-* | openai/gpt-* | openrouter/* 等
OPENCLAW_MODEL=anthropic/claude-3-5-sonnet-20241022

# LLM API Keys（按使用的 provider 填写对应的 Key，其余留空即可）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
OPENAI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Docker 共享卷 (与 docker-compose.yml 中的 volume mount 对应)
OPENCLAW_MEDIA_MOUNT=/openclaw-media

# CORS (nginx 同源访问，"*" 即可)
CORS_ORIGINS=*

# ── Docker Compose 变量 ────────────────────────────────────

# 前端暴露端口 (默认 80)
EXPOSE_PORT=80

# OpenClaw Docker 镜像 (官方 GitHub Container Registry 镜像)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# OpenClaw 时区（影响容器内日志时间戳）
OPENCLAW_TZ=Asia/Shanghai

# OpenClaw 宿主机暴露端口（容器内固定 18789/18791，宿主机端口可调整避免冲突）
# 如果宿主机已有其他服务占用 18789，改为未占用的端口（如 28789）
OPENCLAW_HOST_PORT=28789
OPENCLAW_HOST_PORT_BROWSER=28791
